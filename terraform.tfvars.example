# AWS Configuration
aws_region = "us-west-2"

# Project Configuration
project_name = "kube-agro"

# Existing Infrastructure Configuration (REQUIRED)
# Get these values from your AWS Console or CLI:
# aws ec2 describe-vpcs --query 'Vpcs[*].[VpcId,CidrBlock,Tags[?Key==`Name`].Value|[0]]' --output table
# aws ec2 describe-subnets --query 'Subnets[*].[SubnetId,CidrBlock,AvailabilityZone,Tags[?Key==`Name`].Value|[0]]' --output table
vpc_id = "vpc-12345678"  # Replace with your existing VPC ID
subnet_id = "subnet-12345678"  # Replace with your existing subnet ID

# Internet Gateway (optional - leave empty if VPC has default IGW)
# aws ec2 describe-internet-gateways --query 'InternetGateways[*].[InternetGatewayId,Tags[?Key==`Name`].Value|[0]]' --output table
internet_gateway_id = ""  # Optional: specify if you have a custom IGW

# EC2 Configuration
instance_type = "t3.medium"  # Minimum recommended for Kubernetes
volume_size = 20

# SSH Public Key (OPTIONAL - leave empty to disable SSH key access)
# Generate a key pair if you want SSH access:
# ssh-keygen -t rsa -b 4096 -f ~/.ssh/kube-agro-key
# Then copy the public key content here
public_key = ""  # Leave empty to disable SSH key access

# Optional: Custom AMI ID
# custom_ami_id = "ami-1234567890abcdef0"

# Additional Tags
tags = {
  Environment = "development"
  Project     = "kubernetes-argocd"
  Owner       = "your-name"
}
