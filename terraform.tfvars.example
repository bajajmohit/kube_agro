# AWS Configuration
aws_region = "us-west-2"

# Project Configuration
project_name = "kube-agro"

# Existing Infrastructure Configuration (HARDCODED)
vpc_id = "vpc-2dc2d444"
subnet_id = "subnet-5f25ec37"
internet_gateway_id = "igw-6098f609"

# EC2 Configuration
instance_type = "t3.medium"  # Minimum recommended for Kubernetes
volume_size = 20

# Note: Using existing key pair "kube_agro" - no SSH key configuration needed

# Optional: Custom AMI ID
# custom_ami_id = "ami-1234567890abcdef0"

# Additional Tags
tags = {
  Environment = "development"
  Project     = "kubernetes-argocd"
  Owner       = "your-name"
}
